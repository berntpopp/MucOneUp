        "G3|+",
        "G3|-",
        "G4|+",
        "G4|-"
      ],
      "excluded_keys": {},
      "rule": "log_odds_interpolate: runs without a fitted entry of the same base and strand (strand 'both' if no strand-specific entry) interpolate the error log-odds and error shape linearly between the nearest fitted lengths on both sides; beyond the longest (or below the shortest) fitted length the error odds of that entry are scaled by exp(log_odds_slope_per_base * length difference), with the difference capped at max_extrapolation_bases; bases without fitted entries, or references without a usable error delta, use the generic pmf",
      "slope": "median least-squares slope of error log-odds vs length over base/strand groups with >= 3 fitted lengths, clamped at 0",
      "generic": "n-weighted pool of fitted entries at length 3; used with a warning for bases without any fitted entry",
      "target_key": "ont_amplicon_PRJEB92208"
    },
    "unit_stutter_fit": {
      "method": "P(slip) of a full product = unit_stutter_rate * VNTR units; rate = pooled slipped products / pooled molecule units, pmf = pooled share of each k, over per_allele_stutter_and_length_noise (k = -2, -1, +1 units)",
